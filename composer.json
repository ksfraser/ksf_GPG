{
    "name": "ksfraser/ksf_gpg",
    "description": "GPG business logic library providing key management, signing, encryption, and keyserver operations",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "KSF Development Team",
            "email": "admin@ksfraser.com"
        }
    ],
    "require": {
        "php": ">=7.3",
        "pear/crypt_gpg": "^1.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0||^10.0"
    },
    "autoload": {
        "psr-4": {
            "ksfraser\\GPG\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ksfraser\\GPG\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "keywords": [
        "gpg",
        "gnupg",
        "encryption",
        "signing",
        "keyserver",
        "pgp",
        "openpgp",
        "frontaccounting"
    ]
}
